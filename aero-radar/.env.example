# Environment Variable Configuration
# Copy this file to .env.local and fill in values as needed.

# ============================================================
# App Identity
# ============================================================
NEXT_PUBLIC_APP_NAME="AeroRadar Flight Tracker"
NEXT_PUBLIC_APP_VERSION="1.0.0"

# ============================================================
# Flight Data Provider
# Options: MOCK | OPENSKY | AVIATIONSTACK
# ============================================================
FLIGHT_DATA_PROVIDER=MOCK

# ============================================================
# OpenSky Network (free, ADS-B real-time data)
# Required only when FLIGHT_DATA_PROVIDER=OPENSKY
# Register at: https://opensky-network.org/
# ============================================================
# OPENSKY_USERNAME=your_username
# OPENSKY_PASSWORD=your_password

# ============================================================
# AviationStack (commercial flight schedule data)
# Required only when FLIGHT_DATA_PROVIDER=AVIATIONSTACK
# Register at: https://aviationstack.com/
# ============================================================
# AVIATIONSTACK_API_KEY=your_api_key_here
